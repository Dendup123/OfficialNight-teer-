<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NightTeer</title>
<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
  <h1>NightTeer</h1>
  <p>Live FR / SR Result Dashboard</p>
</header>

<div class="card">
  <h2>Today Result</h2>
  <p>Date: <span id="date">--</span></p>
  <p>FR: <span id="fr">--</span></p>
  <p>SR: <span id="sr">--</span></p>
</div>

<div class="card">
  <h2>Common Numbers</h2>
  <p id="common">Loading...</p>
</div>

<div class="card">
  <h2>Result History</h2>
  <table id="history"></table>
</div>

<footer>
  <p>NightTeer • GitHub Pages</p>
</footer>

<script src="script.js"></script>

</body>
</html>
