body{
  font-family: Arial;
  margin:0;
  background:#0b1220;
  color:white;
  text-align:center;
}

header{
  background:#111b2e;
  padding:20px;
}

.card{
  background:#16243a;
  margin:15px;
  padding:15px;
  border-radius:10px;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  padding:8px;
  border-bottom:1px solid #2c3e50;
}
